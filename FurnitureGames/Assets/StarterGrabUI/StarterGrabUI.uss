:root {
  --font-muesou-900: url("project://database/Assets/Fonts/MuseoSansRounded1000 SDF.asset");
}

.starter-grab-u-i {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;

    font-size: 36px;
    -unity-font-definition: var(--font-muesou-900);
    -unity-text-align: middle-center;

    color: #ffffff;
    /*
    -unity-text-outline-color: rgba(0,0,0,0.25);
    -unity-text-outline-width: 1px;
    text-shadow: 0 3 0 rgba(0,0,0,0.5);
    */
}


#shop_card{
    width: 320px;
    height: 500px;

    background-color: #141317;
    border-radius: 20px;

    align-items: center;
    justify-content: space-around;
}

.collection_button {
    width: 274px; /* x .8 = 274.4 */
    height: 115px; /* x .8 = 115.2 */
    background-color: rgba(255, 255, 255, 0.25);
    border-radius: 8px;
    margin-bottom: 20px;
}

.collection_button_name{
    width:auto;
    height: auto;
    margin: auto;
    margin-bottom: 10px;
    margin-left: 10px;
    color : #ffffff;
    font-size: 13px;
    text-shadow: 0 3 0 rgba(0,0,0,0.5);
}