/*
    MergeIslandHUD -- full-screen merge-and-unlock board.

    Geometry: 7 columns at a 44px pitch (40px cell + 2px margin all round) = 308px of grid.
    The frame HUGS that fixed-pixel width rather than taking a percentage, because Yoga counts
    padding inside `width` and a percentage frame would silently clip the last column.

    The 2px margin around each cell is load-bearing: borders draw OUTSIDE the content box, so
    the drop-target highlight's border needs that gap to draw into or it would overlap its
    neighbours.

    Runtime constraints this file works around (carried over from the Drop Four build):
      * background-position and percent/negative insets on absolutes are IGNORED, so framing
        is done with a larger wrapper element, never negative insets.
      * percent translate shifts rendering but is NOT reflected in worldBound. The drag
        hit-tests against worldBound, so the lifted item animates layout left/top and never
        percent translate.

    Art: the item chain is a single linear ladder of MAX_TIER rungs. Real art comes from the
    `tierSprites` array on the MergeIslandHUD component, applied as backgroundImage from Lua.
    The .item-tier-N classes below are the fallback for any tier with no sprite assigned yet --
    a colour ramp plus the tier number, so the board stays readable before art exists.
*/
:root {
    --font-museo-700: url("project://database/Packages/com.pz.studio/Assets/Fonts/MuseoSansRounded-700 SDF.asset");
    --font-museo-900: url("project://database/Packages/com.pz.studio/Assets/Fonts/MuseoSansRounded-900 SDF.asset");

    /* Beach palette, sampled from the prototype. */
    --mi-sky: #7fd4e8;
    --mi-sand-frame: #e8c9a0;
    --mi-sand-inset: #f2ddb8;
    --mi-locked: #e0be93;
    --mi-locked-edge: #c9a476;
    --mi-water: #9fdcef;
    --mi-water-edge: #7cc4da;

    --mi-text: #5b3f22;
    --mi-text-light: #fffaf0;
    --mi-scrim: rgba(20, 40, 60, 0.55);
    --mi-toast-bg: rgba(45, 32, 18, 0.88);

    --mi-green: #67c23a;
    --mi-green-dark: #4f9c2b;
    --mi-red: #e8483f;
    --mi-gold: #f0b429;
    --mi-highlight: #7cf34a;

    /* Placeholder item colours, one per rung of the ladder. A deliberate low-to-high ramp
       (pale shell -> gold chest) so the tier is legible at a glance before real art exists. */
    --mi-tier-1: #f6e0c0;
    --mi-tier-2: #66d4b8;
    --mi-tier-3: #4aa3e0;
    --mi-tier-4: #9b6ede;
    --mi-tier-5: #f0b429;
}

.merge-island-h-u-d {
    position: absolute;
    width: 100%;
    height: 100%;
}

.hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: var(--mi-text);
    -unity-font-definition: var(--font-museo-900);
    -unity-text-align: middle-center;
}

.hud-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--mi-sky);
}

/* ---------------------------- top bar --------------------------- */

.top-bar {
    position: absolute;
    top: 16px;
    left: 0;
    width: 100%;
    height: 44px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 18px;
    padding-right: 18px;
}

.info-button {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: var(--mi-green);
    border-width: 2px;
    border-color: var(--mi-text-light);
    align-items: center;
    justify-content: center;
}

.info-glyph {
    font-size: 18px;
    color: var(--mi-text-light);
    -unity-font-definition: var(--font-museo-900);
    -unity-text-align: middle-center;
}

.close-button {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: var(--mi-red);
    border-width: 2px;
    border-color: var(--mi-text-light);
    align-items: center;
    justify-content: center;
}

.close-glyph {
    font-size: 16px;
    color: var(--mi-text-light);
    -unity-font-definition: var(--font-museo-900);
    -unity-text-align: middle-center;
}

/* ----------------------------- board ---------------------------- */

.board-area {
    align-items: center;
    justify-content: center;
}

/* Content-driven width: 308px of grid + 10px padding each side. */
.board-frame {
    padding: 10px;
    border-radius: 20px;
    background-color: var(--mi-sand-frame);
    border-width: 2px;
    border-color: var(--mi-locked-edge);
    align-items: center;
}

.board-grid {
    flex-direction: column;
    align-items: center;
}

.board-row {
    flex-direction: row;
}

/* The cell is the tap target. pickingMode is also set in Lua, since dynamically created
   elements are not reliably tappable from a USS rule alone. */
.cell {
    width: 40px;
    height: 40px;
    margin: 2px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

/* Locked and blank -- solid sand, no hint of what goes there yet. */
.cell-hidden {
    background-color: var(--mi-locked);
    border-width: 1px;
    border-color: var(--mi-locked-edge);
}

/* Locked but ghosted -- same sand tile, but it shows a faded silhouette of what it accepts. */
.cell-ghost {
    background-color: var(--mi-sand-inset);
    border-width: 1px;
    border-color: var(--mi-locked-edge);
}

/* Unlocked and playable -- reads as water punched through the sand. */
.cell-open {
    background-color: var(--mi-water);
    border-width: 1px;
    border-color: var(--mi-water-edge);
}

/* Legal drop target under the dragged item. A ring INSIDE the margin gap, since borders draw
   outside the content box. */
.cell-drop-target {
    border-width: 2px;
    border-color: var(--mi-highlight);
}

.cell-item {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    /* So an assigned tier sprite fits the cell without distorting its aspect. */
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

/* Shown when the cell actually has something to draw (a real item, or a ghost silhouette). */
.cell-item-visible {
    display: flex;
}

/* A ghost's silhouette: the item's own colour, knocked back so it reads as a target rather
   than a thing you own. */
.cell-item-ghost {
    opacity: 0.35;
}

/* The source cell while its item is lifted: the item is hidden, not removed, so the grid
   layout never reflows mid-drag (which would move every worldBound the drop reads). */
.cell-item-lifted {
    opacity: 0;
}

.cell-tier {
    font-size: 15px;
    color: var(--mi-text-light);
    -unity-font-definition: var(--font-museo-900);
    -unity-text-align: middle-center;
}

.loading-label {
    margin-top: 14px;
    font-size: 15px;
    color: var(--mi-text);
    -unity-font-definition: var(--font-museo-700);
    -unity-text-align: middle-center;
    display: none;
}

/* --------------------------- bottom bar ------------------------- */

.bottom-bar {
    position: absolute;
    bottom: 58px;
    left: 0;
    width: 100%;
    height: 62px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.energy-chip {
    width: 96px;
    height: 40px;
    margin-right: 12px;
    border-radius: 20px;
    background-color: var(--mi-sand-frame);
    border-width: 2px;
    border-color: var(--mi-locked-edge);
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.energy-bolt {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    border-radius: 4px;
    background-color: var(--mi-gold);
}

.energy-label {
    font-size: 18px;
    color: var(--mi-text);
    -unity-font-definition: var(--font-museo-900);
    -unity-text-align: middle-center;
}

.generator-button {
    width: 116px;
    height: 58px;
    border-radius: 18px;
    background-color: var(--mi-green);
    border-width: 3px;
    border-color: var(--mi-green-dark);
    align-items: center;
    justify-content: center;
}

/* Out of energy or nowhere to put an item: greyed so the refusal is legible before the tap. */
.generator-button-disabled {
    opacity: 0.45;
}

.generator-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background-color: var(--mi-sand-inset);
}

.multiplier-chip {
    width: 62px;
    height: 40px;
    margin-left: 12px;
    border-radius: 20px;
    background-color: var(--mi-sand-frame);
    border-width: 2px;
    border-color: var(--mi-locked-edge);
    align-items: center;
    justify-content: center;
}

.multiplier-label {
    font-size: 17px;
    color: var(--mi-text);
    -unity-font-definition: var(--font-museo-900);
    -unity-text-align: middle-center;
}

/* Transient feedback pill. Sits above the generator so it reads as a response to pressing it.
   Starts at opacity 0 and display none; Lua fades and slides it in, then fades it out. */
.toast-row {
    position: absolute;
    bottom: 130px;
    left: 0;
    width: 100%;
    align-items: center;
}

.toast {
    padding: 8px 18px;
    border-radius: 16px;
    background-color: var(--mi-toast-bg);
    color: var(--mi-text-light);
    font-size: 14px;
    -unity-font-definition: var(--font-museo-900);
    -unity-text-align: middle-center;
    white-space: normal;
    opacity: 0;
    display: none;
}

.hint-label {
    position: absolute;
    bottom: 22px;
    left: 0;
    width: 100%;
    font-size: 13px;
    color: var(--mi-text);
    -unity-font-definition: var(--font-museo-700);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------------------- world-top entry point -------------------- */
/* Built in Lua and handed to UI:AddWorldTopButton, so nothing else in the scene needs to know
   Merge Island exists. */

.world-top-button {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background-color: var(--mi-green);
    border-width: 2px;
    border-color: var(--mi-text-light);
    align-items: center;
    justify-content: center;
}

.world-top-glyph {
    font-size: 18px;
    color: var(--mi-text-light);
    -unity-font-definition: var(--font-museo-900);
    -unity-text-align: middle-center;
}

/* -------------------------- drag layer -------------------------- */

.flight-layer {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* The lifted item. Sized to match .cell-item so it lands flush, and slightly scaled up so it
   reads as picked up. Positioned by layout left/top from Lua, never percent translate. */
.flying-item {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------------------------- items ----------------------------- */
/* One class per rung of the single linear ladder, declared last so they win the cascade over
   .cell-item's own background.

   These are the PLACEHOLDER fallback only. When a sprite is assigned to a tier in the
   MergeIslandHUD inspector, Lua sets backgroundImage and the sprite covers this colour. Until
   then the colour ramp plus the tier number keeps the board readable. */

.item-tier-1 { background-color: var(--mi-tier-1); }
.item-tier-2 { background-color: var(--mi-tier-2); }
.item-tier-3 { background-color: var(--mi-tier-3); }
.item-tier-4 { background-color: var(--mi-tier-4); }
.item-tier-5 { background-color: var(--mi-tier-5); }
